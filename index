<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Secure CC Optimizer & Sync</title>
    <!-- CryptoJS Library for AES-256 Encryption -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <style>
        :root {
            --bg: #090e17;
            --surface: #121a29;
            --surface-card: #182338;
            --surface-hover: #1f2d47;
            --border: #233352;
            --text: #f8fafc;
            --text-sub: #94a3b8;
            --primary: #38bdf8;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --rupay: #a855f7;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--bg);
            color: var(--text);
            padding: 16px;
            padding-bottom: 95px;
            font-size: 14px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Top Bar */
        .app-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 16px;
        }

        .app-title h1 {
            font-size: 1.25rem;
            color: var(--primary);
            font-weight: 700;
        }

        .app-title p {
            font-size: 0.75rem;
            color: var(--text-sub);
        }

        .header-tools {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .date-picker-wrap input, .key-input {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--primary);
            font-weight: 600;
            padding: 6px 10px;
            border-radius: 8px;
            font-size: 0.8rem;
            outline: none;
        }

        .key-input {
            width: 120px;
            color: var(--text);
        }

        /* Sync Status Pill */
        .sync-badge {
            font-size: 0.72rem;
            padding: 4px 8px;
            border-radius: 20px;
            background: var(--surface-card);
            border: 1px solid var(--border);
            color: var(--text-sub);
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .sync-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--text-sub);
        }

        .sync-dot.synced { background: var(--success); }
        .sync-dot.busy { background: var(--warning); animation: pulse 1s infinite; }
        .sync-dot.error { background: var(--danger); }

        /* Priority Highlights Grid */
        .priority-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .priority-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px;
            position: relative;
            overflow: hidden;
        }

        .priority-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
        }

        .p-due::before { background: var(--danger); }
        .p-swipe::before { background: var(--success); }
        .p-gen::before { background: var(--warning); }

        .p-title {
            font-size: 0.74rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .p-due .p-title { color: var(--danger); }
        .p-swipe .p-title { color: var(--success); }
        .p-gen .p-title { color: var(--warning); }

        .p-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0;
            border-top: 1px dashed rgba(255, 255, 255, 0.08);
        }

        .p-item:first-of-type {
            border-top: none;
            padding-top: 2px;
        }

        .p-name {
            font-size: 0.85rem;
            font-weight: 600;
        }

        .p-sub {
            font-size: 0.72rem;
            color: var(--text-sub);
        }

        /* Metrics Grid */
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 8px;
            margin-bottom: 16px;
        }

        .sum-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 10px 12px;
        }

        .sum-card span {
            display: block;
            font-size: 0.68rem;
            color: var(--text-sub);
            text-transform: uppercase;
        }

        .sum-card strong {
            font-size: 1.05rem;
            margin-top: 2px;
            display: block;
        }

        /* Filter Controls */
        .action-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
        }

        .filter-scroller {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            scrollbar-width: none;
            flex: 1;
        }

        .filter-scroller::-webkit-scrollbar {
            display: none;
        }

        .f-pill {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-sub);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.76rem;
            white-space: nowrap;
            cursor: pointer;
        }

        .f-pill.active {
            background: var(--primary);
            color: #0b0f19;
            font-weight: 700;
            border-color: var(--primary);
        }

        .btn-add-top {
            background: var(--primary);
            color: #0b0f19;
            border: none;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.76rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
        }

        /* Cards Feed (Desktop Responsive Multi-Column) */
        .card-feed {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 12px;
        }

        .card-tile {
            background: var(--surface-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
        }

        .card-main-title {
            font-size: 0.95rem;
            font-weight: 700;
        }

        .card-sub-title {
            font-size: 0.74rem;
            color: var(--text-sub);
        }

        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 0.7rem;
            font-weight: 700;
        }

        .b-safe { background: rgba(16, 185, 129, 0.16); color: var(--success); }
        .b-warn { background: rgba(245, 158, 11, 0.16); color: var(--warning); }
        .b-danger { background: rgba(239, 68, 68, 0.16); color: var(--danger); }
        .b-rupay { background: rgba(168, 85, 247, 0.16); color: var(--rupay); }

        .card-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            background: rgba(0, 0, 0, 0.25);
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 10px;
            font-size: 0.78rem;
        }

        .cg-item span {
            color: var(--text-sub);
            font-size: 0.7rem;
            display: block;
        }

        .cg-item strong {
            font-size: 0.88rem;
        }

        .card-bottom-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 4px;
        }

        .spend-box {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .spend-box label {
            font-size: 0.75rem;
            color: var(--text-sub);
        }

        .spend-box input {
            background: var(--bg);
            border: 1px solid var(--border);
            color: #fff;
            padding: 5px 8px;
            border-radius: 6px;
            width: 95px;
            font-size: 0.84rem;
            text-align: right;
            outline: none;
        }

        .card-actions {
            display: flex;
            gap: 6px;
        }

        .btn-mini {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-sub);
            padding: 5px 9px;
            border-radius: 6px;
            font-size: 0.74rem;
            cursor: pointer;
        }

        .btn-mini:hover {
            color: var(--text);
            background: var(--surface-hover);
        }

        .progress-track {
            height: 5px;
            background: var(--border);
            border-radius: 3px;
            overflow: hidden;
            margin-top: 8px;
        }

        .progress-bar {
            height: 100%;
        }

        /* Fixed Bottom Controls */
        .floating-action {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(18, 26, 41, 0.96);
            backdrop-filter: blur(10px);
            border-top: 1px solid var(--border);
            padding: 10px 16px;
            display: flex;
            gap: 10px;
            z-index: 100;
            max-width: 1200px;
            margin: 0 auto;
        }

        .btn-mob {
            flex: 1;
            padding: 10px 14px;
            border-radius: 8px;
            border: none;
            font-weight: 700;
            font-size: 0.84rem;
            cursor: pointer;
            text-align: center;
        }

        .btn-primary { background: var(--primary); color: #0b0f19; }
        .btn-secondary { background: var(--surface-card); color: var(--text-sub); border: 1px solid var(--border); flex: 0.4; }
        .btn-sync { background: var(--success); color: #0b0f19; }

        /* Modal Overlay */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(4px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 200;
            padding: 16px;
        }

        .modal {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            width: 100%;
            max-width: 440px;
            padding: 18px;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal h2 {
            font-size: 1.1rem;
            color: var(--primary);
            margin-bottom: 12px;
        }

        .form-group {
            margin-bottom: 10px;
        }

        .form-group label {
            display: block;
            font-size: 0.74rem;
            color: var(--text-sub);
            margin-bottom: 4px;
        }

        .form-group input, .form-group select {
            width: 100%;
            background: var(--bg);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 8px 10px;
            border-radius: 6px;
            font-size: 0.85rem;
            outline: none;
        }

        .modal-buttons {
            display: flex;
            gap: 8px;
            margin-top: 16px;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="app-header">
        <div class="app-title">
            <h1>Card Payment & Optimizer</h1>
            <p>Dynamic 30% CIBIL & Due Tracker</p>
        </div>
        <div class="header-tools">
            <div class="sync-badge">
                <div class="sync-dot" id="syncStatusDot"></div>
                <span id="syncStatusText">Local Ready</span>
            </div>
            <input type="password" id="aesSecretKey" class="key-input" placeholder="AES Secret Key" title="Encryption Secret Key">
            <div class="date-picker-wrap">
                <input type="date" id="dateInput" onchange="handleDateChange()">
            </div>
        </div>
    </div>

    <!-- Priority Alerts Section -->
    <div class="priority-section">
        <div class="priority-card p-due">
            <div class="p-title">🚨 Due in Next 7 Days (Pay First)</div>
            <div id="dueList"></div>
        </div>
        <div class="priority-card p-swipe">
            <div class="p-title">💳 Aaj Use Karein (~45 Din Free)</div>
            <div id="swipeList"></div>
        </div>
        <div class="priority-card p-gen">
            <div class="p-title">⚡ Statement Generating Soon (Hold Spends)</div>
            <div id="genList"></div>
        </div>
    </div>

    <!-- Metrics Summary -->
    <div class="summary-grid">
        <div class="sum-card">
            <span>Total Limit</span>
            <strong id="mTotalLimit" style="color: var(--primary);">₹0</strong>
        </div>
        <div class="sum-card">
            <span>Safe 30% Cap</span>
            <strong id="mSafeCap" style="color: var(--success);">₹0</strong>
        </div>
        <div class="sum-card">
            <span>Outstanding</span>
            <strong id="mTotalSpend" style="color: var(--warning);">₹0</strong>
        </div>
        <div class="sum-card">
            <span>Utilization</span>
            <strong id="mUtilPct">0%</strong>
        </div>
    </div>

    <!-- Action Bar -->
    <div class="action-row">
        <div class="filter-scroller">
            <button class="f-pill active" onclick="applyFilter('all', this)">All</button>
            <button class="f-pill" onclick="applyFilter('due', this)">⏳ Sort Due</button>
            <button class="f-pill" onclick="applyFilter('bill', this)">⚡ Sort Bill</button>
            <button class="f-pill" onclick="applyFilter('over30', this)">⚠️ Over 30%</button>
            <button class="f-pill" onclick="applyFilter('rupay', this)">RuPay</button>
        </div>
        <button class="btn-add-top" onclick="openAddModal()">+ Add Card</button>
    </div>

    <!-- Cards Grid Feed -->
    <div class="card-feed" id="cardsFeed"></div>
</div>

<!-- Bottom Floating Action Bar -->
<div class="floating-action">
    <button class="btn-mob btn-secondary" onclick="fetchFromGitHubCloud()">☁️ Pull Cloud</button>
    <button class="btn-mob btn-primary" onclick="saveDataLocally()">💾 Save Local</button>
    <button class="btn-mob btn-sync" onclick="pushToGitHubCloud()">🚀 Encrypt & Push</button>
</div>

<!-- Edit / Add Modal -->
<div class="modal-overlay" id="cardModal">
    <div class="modal">
        <h2 id="modalTitle">Edit Card Details</h2>
        <input type="hidden" id="editCardId">
        
        <div class="form-group">
            <label>Card Name</label>
            <input type="text" id="mCardName" placeholder="e.g. Airtel Axis Bank Master">
        </div>
        <div class="form-group">
            <label>Bank Name</label>
            <input type="text" id="mBankName" placeholder="e.g. Axis Bank">
        </div>
        <div class="form-group">
            <label>Card Number / Identifier</label>
            <input type="text" id="mCardAcc" placeholder="e.g. ...1994">
        </div>
        <div class="form-group">
            <label>Card Type / Network</label>
            <input type="text" id="mCardType" placeholder="e.g. RuPay UPI, Visa CC, Mastercard">
        </div>
        <div class="form-group">
            <label>Category</label>
            <select id="mCardCategory">
                <option value="cc">Regular Credit Card</option>
                <option value="rupay">RuPay / UPI Card</option>
                <option value="creditline">Credit Line / BNPL</option>
            </select>
        </div>
        <div class="form-group">
            <label>Sanctioned Limit (₹)</label>
            <input type="number" id="mCardLimit" placeholder="30000">
        </div>
        <div class="form-group">
            <label>Statement / Bill Generation Day (1 - 31)</label>
            <input type="number" id="mBillDay" min="1" max="31" placeholder="13">
        </div>
        <div class="form-group">
            <label>Payment Due Day (1 - 31)</label>
            <input type="number" id="mDueDay" min="1" max="31" placeholder="4">
        </div>

        <div class="modal-buttons">
            <button class="btn-mob btn-secondary" onclick="closeModal()">Cancel</button>
            <button class="btn-mob btn-primary" onclick="saveModalData()">Save Card</button>
        </div>
    </div>
</div>

<script>
/**
 * 1. GITHUB CONFIGURATION (3-PART SPLIT TOKEN)
 * Replace USERNAME, REPONAME and paste your 3-part split token below.
 */
const GITHUB_CONFIG = {
    owner: "YOUR_GITHUB_USERNAME",
    repo: "YOUR_REPO_NAME",
    filePath: "data.json",
    // Token split into 3 parts to prevent regex-based automated scanners from revoking it:
    p1: "ghp_PartOneStringHere",
    p2: "PartTwoStringHere",
    p3: "PartThreeStringHere"
};

function getReconstructedToken() {
    return `${GITHUB_CONFIG.p1}${GITHUB_CONFIG.p2}${GITHUB_CONFIG.p3}`;
}

let githubFileSha = null;

const baseDataset = [
    { id: 1, bank: "Axis Bank", name: "Airtel Axis Bank Master", acc: "...1994", type: "Mastercard CC", limit: 30489, current: 30489, billDay: 13, dueDay: 4, category: "cc" },
