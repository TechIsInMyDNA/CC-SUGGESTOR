    { id: 3, bank: "HDFC Bank", name: "HDFC Biz Grow 7277", acc: "...7270", type: "Business CC", limit: 58175, current: 2000, billDay: 23, dueDay: 18, category: "cc" },
    { id: 4, bank: "HDFC Bank", name: "HDFC RuPay CC 8078", acc: "...8073", type: "RuPay UPI", limit: 30815, current: 0, billDay: 23, dueDay: 13, category: "rupay" },
    { id: 5, bank: "HDFC Bank", name: "HDFC Swiggy CC 2280", acc: "...2280", type: "Visa CC", limit: 30000, current: 0, billDay: 23, dueDay: 13, category: "cc" },
    { id: 6, bank: "HDFC Bank", name: "HDFC Tata Neu 5860", acc: "...5863", type: "RuPay UPI", limit: 905, current: 0, billDay: 23, dueDay: 13, category: "rupay" },
    { id: 7, bank: "CSB Bank", name: "Jupiter CSB Edge CC", acc: "...4473", type: "RuPay UPI", limit: 49513, current: 46615, billDay: 7, dueDay: 21, category: "rupay" },
    { id: 8, bank: "IDFC FIRST", name: "IDFC FIRST WOW / Secured", acc: "...8909", type: "Secured CC", limit: 34412, current: 2433, billDay: 17, dueDay: 1, category: "cc" },
    { id: 9, bank: "IDFC FIRST", name: "IDFC RuPay CC", acc: "...8910", type: "RuPay UPI", limit: 34412, current: 0, billDay: 17, dueDay: 1, category: "rupay" },
    { id: 10, bank: "BOBCARD", name: "BOB GoldX CC", acc: "...7546", type: "Credit Card", limit: 18590, current: 0, billDay: 14, dueDay: 1, category: "cc" },
    { id: 11, bank: "BOBCARD", name: "BOB GoldX UPI", acc: "...7934", type: "RuPay UPI", limit: 29857, current: 0, billDay: 14, dueDay: 31, category: "rupay" },
    { id: 12, bank: "RBL Bank", name: "RBL Bank Primary", acc: "...9831", type: "Credit Card", limit: 122000, current: 0, billDay: 5, dueDay: 25, category: "cc" },
    { id: 13, bank: "RBL Bank", name: "RBL Bank Secondary", acc: "...4677", type: "Credit Card", limit: 36866, current: 5630, billDay: 12, dueDay: 2, category: "cc" },
    { id: 14, bank: "RBL Bank", name: "RBL Bank Tertiary", acc: "...8328", type: "Credit Card", limit: 65829, current: 0, billDay: 18, dueDay: 8, category: "cc" },
    { id: 15, bank: "Fi / Federal", name: "Fi Federal CC", acc: "...FiCC", type: "Credit Card", limit: 50000, current: 0, billDay: 28, dueDay: 16, category: "cc" },
    { id: 16, bank: "SBM Bank", name: "SBM OneCard", acc: "...9049", type: "Credit Card", limit: 1833, current: 0, billDay: 20, dueDay: 6, category: "cc" },
    { id: 17, bank: "Utkarsh SFB", name: "Stable Money Utkarsh", acc: "...1357", type: "RuPay UPI", limit: 28800, current: 0, billDay: 15, dueDay: 5, category: "rupay" },
    { id: 18, bank: "Suryoday SFB", name: "Paytm Postpaid Suryoday", acc: "...4050", type: "Credit Line", limit: 27000, current: 0, billDay: 1, dueDay: 7, category: "creditline" },
    { id: 19, bank: "CapFloat", name: "Amazon Pay Later", acc: "...3056", type: "BNPL / Line", limit: 5000, current: 0, billDay: 16, dueDay: 5, category: "creditline" },
    { id: 20, bank: "Simpl", name: "Simpl Pay (Bi-Monthly)", acc: "...Line", type: "PayLater", limit: 5000, current: 0, billDay: 10, dueDay: 12, category: "creditline" },
    { id: 21, bank: "Roar Bank", name: "Roar Bank RuPay", acc: "...Roar", type: "RuPay UPI", limit: 10000, current: 0, billDay: 1, dueDay: 27, category: "rupay" },
    { id: 22, bank: "SuperCard", name: "SuperCard RuPay", acc: "...SC", type: "RuPay UPI", limit: 10000, current: 0, billDay: 1, dueDay: 15, category: "rupay" }
];

let cardList = JSON.parse(localStorage.getItem('user_cc_sync_dataset')) || baseDataset;
let currentFilter = 'all';
let viewDate = new Date();

function calcDaysLeft(targetDay, currentDay) {
    if (targetDay >= currentDay) return targetDay - currentDay;
    return (30 - currentDay) + targetDay;
}

function init() {
    document.getElementById('dateInput').value = new Date().toISOString().split('T')[0];
    const savedKey = localStorage.getItem('cc_aes_key');
    if (savedKey) document.getElementById('aesSecretKey').value = savedKey;
    refreshView();
}

function handleDateChange() {
    const val = document.getElementById('dateInput').value;
    if (val) {
        viewDate = new Date(val);
        refreshView();
    }
}

function refreshView() {
    const day = viewDate.getDate();
    renderPriority(day);
    renderCards(day);
}

function renderPriority(day) {
    // 1. Due Soon (Next 7 days & current spend > 0)
    const dueSoon = cardList
        .map(c => ({ ...c, days: calcDaysLeft(c.dueDay, day) }))
        .filter(c => c.current > 0 && c.days <= 7)
        .sort((a, b) => a.days - b.days);

    const dueBox = document.getElementById('dueList');
    if (!dueSoon.length) {
        dueBox.innerHTML = '<div style="font-size:0.75rem; color:var(--text-sub); padding:4px 0;">🎉 Agle 7 dino me koi payment due nahi hai.</div>';
    } else {
        dueBox.innerHTML = dueSoon.map(c => `
            <div class="p-item">
                <div>
                    <div class="p-name">${c.name}</div>
                    <div class="p-sub">Due: <strong>${c.dueDay}th</strong> | Pay: <strong style="color:var(--danger)">₹${c.current.toLocaleString('en-IN')}</strong></div>
                </div>
                <span class="badge b-danger">${c.days === 0 ? 'DUE TODAY' : c.days + 'd left'}</span>
            </div>
        `).join('');
    }

    // 2. Best Swipe (statement just passed & spend < 30%)
    const bestSwipe = cardList
        .map(c => {
            let passed = (day >= c.billDay) ? (day - c.billDay) : (30 + day - c.billDay);
            let safe30 = c.limit * 0.30;
            let buffer = safe30 - c.current;
            return { ...c, passed, buffer };
        })
        .filter(c => c.buffer > 300 && c.passed >= 0 && c.passed <= 7)
        .sort((a, b) => a.passed - b.passed)
        .slice(0, 2);

    const swipeBox = document.getElementById('swipeList');
    if (!bestSwipe.length) {
        swipeBox.innerHTML = '<div style="font-size:0.75rem; color:var(--text-sub); padding:4px 0;">Sabhi cards ka cycle normal hai ya limit full hai.</div>';
    } else {
        swipeBox.innerHTML = bestSwipe.map(c => `
            <div class="p-item">
                <div>
                    <div class="p-name">${c.name}</div>
                    <div class="p-sub">Bill Bana: <strong>${c.billDay}th</strong> | Buffer: <strong style="color:var(--success)">₹${Math.round(c.buffer).toLocaleString('en-IN')}</strong></div>
                </div>
                <span class="badge b-safe">~45d Free</span>
            </div>
        `).join('');
    }

    // 3. Statement Generating
    const genSoon = cardList
        .map(c => ({ ...c, days: calcDaysLeft(c.billDay, day), util: c.limit > 0 ? ((c.current/c.limit)*100).toFixed(0) : 0 }))
        .filter(c => c.days <= 4)
        .sort((a, b) => a.days - b.days);

    const genBox = document.getElementById('genList');
    if (!genSoon.length) {
        genBox.innerHTML = '<div style="font-size:0.75rem; color:var(--text-sub); padding:4px 0;">Agle 4 dino me koi statement nahi ban raha.</div>';
    } else {
        genBox.innerHTML = genSoon.map(c => `
            <div class="p-item">
                <div>
                    <div class="p-name">${c.name}</div>
                    <div class="p-sub">Bill Date: <strong>${c.billDay}th</strong> | Current: ₹${c.current.toLocaleString('en-IN')}</div>
                </div>
                <span class="badge ${c.util > 30 ? 'b-danger' : 'b-warn'}">${c.days === 0 ? 'Today' : c.days + 'd me bill'}</span>
            </div>
        `).join('');
    }
}

function renderCards(day) {
    const feed = document.getElementById('cardsFeed');
    feed.innerHTML = '';

    let tLimit = 0, tSafe = 0, tSpend = 0;

    let list = cardList.map(c => {
        const util = c.limit > 0 ? (c.current / c.limit) * 100 : 0;
        const dueDays = calcDaysLeft(c.dueDay, day);
        const billDays = calcDaysLeft(c.billDay, day);
        return { ...c, util, dueDays, billDays };
    });

    if (currentFilter === 'rupay') list = list.filter(c => c.type.toLowerCase().includes('rupay') || c.category === 'rupay');
    if (currentFilter === 'over30') list = list.filter(c => c.util > 30);
    if (currentFilter === 'due') list.sort((a, b) => a.dueDays - b.dueDays);
    if (currentFilter === 'bill') list.sort((a, b) => a.billDays - b.billDays);

    list.forEach(c => {
        tLimit += c.limit;
        const safe30 = Math.round(c.limit * 0.30);
        tSafe += safe30;
        tSpend += c.current;

        let uBadge = "b-safe";
        let uFill = "var(--success)";
        if (c.util > 30 && c.util <= 60) { uBadge = "b-warn"; uFill = "var(--warning)"; }
        else if (c.util > 60) { uBadge = "b-danger"; uFill = "var(--danger)"; }

        const isRuPay = c.type.toLowerCase().includes('rupay') || c.category === 'rupay';

        const tile = document.createElement('div');
        tile.className = 'card-tile';
        tile.innerHTML = `
            <div class="card-top">
                <div>
                    <div class="card-main-title">${c.name}</div>
                    <div class="card-sub-title">${c.bank} • ${c.acc}</div>
                </div>
                <div style="display:flex; align-items:center; gap:6px;">
                    <span class="badge ${isRuPay ? 'b-rupay' : 'b-safe'}">${c.type}</span>
                    <button class="btn-mini" onclick="openEditModal(${c.id})">✏️</button>
                    <button class="btn-mini" style="color:var(--danger);" onclick="deleteCard(${c.id})">🗑️</button>
                </div>
            </div>

            <div class="card-grid">
                <div class="cg-item">
                    <span>Sanctioned Limit</span>
                    <strong>₹${c.limit.toLocaleString('en-IN')}</strong>
                </div>
                <div class="cg-item">
                    <span>30% Safe Max</span>
                    <strong style="color:var(--success);">₹${safe30.toLocaleString('en-IN')}</strong>
                </div>
                <div class="cg-item">
                    <span>Statement Date</span>
                    <strong>${c.billDay}th <small style="color:var(--text-sub)">(${c.billDays}d)</small></strong>
                </div>
                <div class="cg-item">
                    <span>Due Date</span>
                    <strong style="color:${c.dueDays <= 5 && c.current > 0 ? 'var(--danger)' : 'var(--text)'};">${c.dueDay}th <small style="color:var(--text-sub)">(${c.dueDays}d)</small></strong>
                </div>
            </div>

            <div class="card-bottom-row">
                <div class="spend-box">
                    <label>Spend:</label>
                    <input type="number" value="${c.current}" onchange="updateCardSpend(${c.id}, this.value)">
                </div>
                <div>
                    <span class="badge ${uBadge}">${c.util.toFixed(1)}% Used</span>
                </div>
            </div>

            <div class="progress-track">
                <div class="progress-bar" style="width: ${Math.min(c.util, 100)}%; background: ${uFill};"></div>
            </div>
        `;
        feed.appendChild(tile);
    });

    document.getElementById('mTotalLimit').innerText = '₹' + tLimit.toLocaleString('en-IN');
    document.getElementById('mSafeCap').innerText = '₹' + tSafe.toLocaleString('en-IN');
    document.getElementById('mTotalSpend').innerText = '₹' + tSpend.toLocaleString('en-IN');

    const totalUtil = tLimit > 0 ? ((tSpend / tLimit) * 100).toFixed(1) : 0;
    const uBox = document.getElementById('mUtilPct');
    uBox.innerText = totalUtil + '%';
    uBox.style.color = totalUtil > 30 ? 'var(--danger)' : 'var(--success)';
}

function updateCardSpend(id, val) {
    const card = cardList.find(c => c.id === id);
    if (card) {
        card.current = parseFloat(val) || 0;
        renderPriority(viewDate.getDate());
    }
}

function applyFilter(filter, el) {
    currentFilter = filter;
    document.querySelectorAll('.f-pill').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    renderCards(viewDate.getDate());
}

/* Modal Edit/Add */
function openAddModal() {
    document.getElementById('modalTitle').innerText = 'Add New Card';
    document.getElementById('editCardId').value = '';
    document.getElementById('mCardName').value = '';
    document.getElementById('mBankName').value = '';
    document.getElementById('mCardAcc').value = '';
    document.getElementById('mCardType').value = 'RuPay UPI';
    document.getElementById('mCardCategory').value = 'rupay';
    document.getElementById('mCardLimit').value = '';
    document.getElementById('mBillDay').value = '';
    document.getElementById('mDueDay').value = '';
    document.getElementById('cardModal').style.display = 'flex';
}

function openEditModal(id) {
    const card = cardList.find(c => c.id === id);
    if (!card) return;

    document.getElementById('modalTitle').innerText = 'Edit Card Details';
    document.getElementById('editCardId').value = card.id;
    document.getElementById('mCardName').value = card.name;
    document.getElementById('mBankName').value = card.bank;
    document.getElementById('mCardAcc').value = card.acc;
    document.getElementById('mCardType').value = card.type;
    document.getElementById('mCardCategory').value = card.category;
    document.getElementById('mCardLimit').value = card.limit;
    document.getElementById('mBillDay').value = card.billDay;
    document.getElementById('mDueDay').value = card.dueDay;
    document.getElementById('cardModal').style.display = 'flex';
}

function closeModal() {
    document.getElementById('cardModal').style.display = 'none';
}

function saveModalData() {
    const editId = document.getElementById('editCardId').value;
    const name = document.getElementById('mCardName').value.trim() || 'Custom Card';
    const bank = document.getElementById('mBankName').value.trim() || 'Bank';
    const acc = document.getElementById('mCardAcc').value.trim() || '...0000';
    const type = document.getElementById('mCardType').value.trim() || 'Credit Card';
    const category = document.getElementById('mCardCategory').value;
    const limit = parseFloat(document.getElementById('mCardLimit').value) || 0;
    const billDay = parseInt(document.getElementById('mBillDay').value) || 1;
    const dueDay = parseInt(document.getElementById('mDueDay').value) || 20;

    if (editId) {
        const card = cardList.find(c => c.id == editId);
        if (card) {
            card.name = name;
            card.bank = bank;
            card.acc = acc;
            card.type = type;
            card.category = category;
            card.limit = limit;
            card.billDay = billDay;
            card.dueDay = dueDay;
        }
    } else {
        cardList.push({
            id: Date.now(),
            name, bank, acc, type, category,
            limit, current: 0,
            billDay, dueDay
        });
    }

    closeModal();
    saveDataLocally();
}

function deleteCard(id) {
    if (confirm("Kya aap sach me is card ko delete karna chahte hain?")) {
        cardList = cardList.filter(c => c.id !== id);
        saveDataLocally();
    }
}

function saveDataLocally() {
    localStorage.setItem('user_cc_sync_dataset', JSON.stringify(cardList));
    const key = document.getElementById('aesSecretKey').value;
    if (key) localStorage.setItem('cc_aes_key', key);
    refreshView();
    updateSyncStatus('synced', 'Local Saved');
}

/**
 * 2. AES-256 ENCRYPTION & GITHUB SYNC
 */
function updateSyncStatus(type, msg) {
    const dot = document.getElementById('syncStatusDot');
    const txt = document.getElementById('syncStatusText');
    dot.className = 'sync-dot ' + type;
    txt.innerText = msg;
}

// Push to GitHub data.json with AES-256
async function pushToGitHubCloud() {
    const key = document.getElementById('aesSecretKey').value.trim();
    if (!key) {
        alert("Pehle AES Secret Key dalein! Iske bina data encrypt nahi hoga.");
        return;
    }

    updateSyncStatus('busy', 'Encrypting & Pushing...');

    try {
        const rawJson = JSON.stringify(cardList);
        const encrypted = CryptoJS.AES.encrypt(rawJson, key).toString();

        const payloadContent = JSON.stringify({
            updated_at: new Date().toISOString(),
            payload: encrypted
        }, null, 2);

        const token = getReconstructedToken();
        const url = `https://api.github.com/repos/${GITHUB_CONFIG.owner}/${GITHUB_CONFIG.repo}/contents/${GITHUB_CONFIG.filePath}`;

        // Get latest SHA if not present
        if (!githubFileSha) {
            const getRes = await fetch(url, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            if (getRes.ok) {
                const getData = await getRes.json();
                githubFileSha = getData.sha;
            }
        }

        const body = {
            message: `Update encrypted card data: ${new Date().toLocaleDateString()}`,
            content: btoa(unescape(encodeURIComponent(payloadContent))),
            sha: githubFileSha || undefined
        };

        const res = await fetch(url, {
            method: 'PUT',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(body)
        });

        if (res.ok) {
            const resData = await res.json();
            githubFileSha = resData.content.sha;
            localStorage.setItem('cc_aes_key', key);
            updateSyncStatus('synced', 'Cloud Synced');
            alert('✅ Encrypted data GitHub par safely sync ho gaya!');
        } else {
            throw new Error(`GitHub API Error: ${res.status}`);
        }
    } catch (err) {
        console.error(err);
        updateSyncStatus('error', 'Push Failed');
        alert('❌ GitHub Sync fail ho gaya. Configuration ya Token check karein.');
    }
}

// Pull from GitHub data.json and Decrypt AES-256
async function fetchFromGitHubCloud() {
    const key = document.getElementById('aesSecretKey').value.trim();
    if (!key) {
        alert("Pehle AES Secret Key dalein data decrypt karne ke liye.");
        return;
    }

    updateSyncStatus('busy', 'Pulling & Decrypting...');

    try {
        const token = getReconstructedToken();
        const url = `https://api.github.com/repos/${GITHUB_CONFIG.owner}/${GITHUB_CONFIG.repo}/contents/${GITHUB_CONFIG.filePath}`;

        const res = await fetch(url, {
            headers: { 'Authorization': `Bearer ${token}` }
        });

        if (!res.ok) throw new Error('File not found or unauthorized');

        const fileData = await res.json();
        githubFileSha = fileData.sha;
        const decodedContent = decodeURIComponent(escape(atob(fileData.content)));
        const parsed = JSON.parse(decodedContent);

        if (!parsed.payload) throw new Error('Invalid data.json schema');

        const bytes = CryptoJS.AES.decrypt(parsed.payload, key);
        const decryptedJson = bytes.toString(CryptoJS.enc.Utf8);

        if (!decryptedJson) {
            throw new Error('Wrong AES Key');
        }

        cardList = JSON.parse(decryptedJson);
        saveDataLocally();
        updateSyncStatus('synced', 'Decrypted & Synced');
        alert('✅ Cloud se encrypted data successfully load aur decrypt ho gaya!');
    } catch (err) {
        console.error(err);
        updateSyncStatus('error', 'Decrypt Error');
        alert('❌ Data load/decrypt nahi ho saka. Kripya AES Key ya Repo path check karein.');
    }
}

